{
  "name": "ai-free-vscode",
  "displayName": "SYNVOX — AI Chat & Agent",
  "description": "SYNVOX: AI chat, coding agents, project memory and Qwen account switching. Free for personal use. Provider accounts and limits apply.",
  "version": "0.5.65",
  "publisher": "developers-daily-life",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Staks-sor/ai-free.git",
    "directory": "plugin-for-vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "assistant",
    "chat",
    "coding",
    "coding-agent",
    "ai-coding-assistant",
    "deepseek",
    "qwen",
    "chatgpt",
    "google-ai",
    "glm",
    "openai-compatible-api",
    "local-ai",
    "vscode-extension",
    "developer-tools"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-free-sidebar",
          "title": "SYNVOX",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ai-free-sidebar": [
        {
          "type": "webview",
          "id": "ai-free-chat",
          "name": "SYNVOX — AI Chat & Agent"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && npx @vscode/vsce package"
  },
  "dependencies": {
    "patchright": "^1.60.2",
    "playwright": "^1.60.0",
    "pngjs": "7.0.0"
  },
  "homepage": "https://synvox.pro/",
  "optionalDependencies": {
    "@jitsi/robotjs": "0.6.24"
  }
}
